		"devdoc": {
			"details": "Stores and manages all campaign data. Does NOT hold ETH.      Only the StartupFund contract (set as authorized) can write state.",
			"kind": "dev",
			"methods": {
				"checkStatus(uint256)": {
					"details": "Evaluates and updates the campaign status.      - Goal reached at any time → FUNDED      - Deadline passed + goal not met → CANCELLED      Called by StartupFund after every contribution, withdraw, and refund.      Implements ICampaign.checkStatus()."
				},
				"createCampaign(string,string,string,string,string,string,uint256,uint256,uint256,string)": {
					"details": "Creates a new campaign. Called by StartupFund.createCampaign().      Function signature must exactly match StartupFund ABI."
				},
				"getCampaign(uint256)": {
					"details": "Required by ICampaign — returns core campaign fields."
				},
				"getCampaignDescription(uint256)": {
					"details": "Returns the full description. Called by useCampaigns.ts."
				},
				"getCampaignMeta(uint256)": {
					"details": "Returns metadata fields. Called by useCampaigns.ts."
				},
				"getCampaignStats(uint256)": {
					"details": "Returns numeric/status fields. Called by useCampaigns.ts."
				},
				"getStatus(uint256)": {
					"details": "Returns the status as uint8. Called by useCampaigns.ts."
				},
				"setAuthorized(address)": {
					"details": "Called once after StartupFund is deployed."
				},
				"updateRaisedAmount(uint256,uint256,bool)": {
					"details": "Updates the raised amount and backer count. Called by StartupFund.fundCampaign()."
				}
			},
			"title": "CampaignManager",
			"version": 1
