		"devdoc": {
			"details": "Holds all ETH contributions. Releases or refunds on instruction      from the authorized StartupFund contract only.      Uses CEI (Checks-Effects-Interactions) pattern on all ETH transfers.",
			"kind": "dev",
			"methods": {
				"campaignBalance(uint256)": {
					"details": "Returns total ETH held for a campaign (sum of all contributor deposits)."
				},
				"deposit(uint256,address)": {
					"details": "Records a contribution for campaignId from contributor.      ETH is sent directly to this contract (via StartupFund forwarding msg.value)."
				},
				"getContribution(uint256,address)": {
					"details": "Returns the contribution amount for a specific contributor."
				},
				"getContributors(uint256)": {
					"details": "Returns all contributor addresses for a campaign."
				},
				"issueRefund(uint256,address)": {
					"details": "Refunds a single contributor's contribution for campaignId.      Called by StartupFund.claimRefund() after campaign is cancelled.      CEI: zero out balance before transferring ETH."
				},
				"releaseFunds(uint256,address)": {
					"details": "Releases the full campaign balance to the creator.      Called by StartupFund.withdraw() after goal is met.      CEI: mark released before transferring ETH."
				},
				"setAuthorized(address)": {
					"details": "Called once after StartupFund is deployed."
				}
			},
			"title": "FundingVault",
			"version": 1
