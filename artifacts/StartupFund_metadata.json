		"devdoc": {
			"details": "Orchestrates all user-facing actions.      - Does NOT hold ETH (all ETH goes to FundingVault).      - Delegates campaign data to CampaignManager.      - Delegates access control to AccessControl.      - Mints reward tokens via RewardToken. Function signatures must EXACTLY match STARTUPFUND_ABI in src/lib/contracts.ts.",
			"kind": "dev",
			"methods": {
				"claimRefund(uint256)": {
					"details": "Contributor claims a refund after campaign is CANCELLED.      - Contributor must have a non-zero contribution."
				},
				"constructor": {
					"params": {
						"_accessControl": "Address of deployed AccessControl",
						"_campaignManager": "Address of deployed CampaignManager",
						"_fundingVault": "Address of deployed FundingVault",
						"_rewardToken": "Address of deployed RewardToken"
					}
				},
				"createCampaign(string,string,string,string,string,string,uint256,uint256,uint256,string)": {
					"details": "Creates a new campaign. Only registered, unblocked users.      Signature matches STARTUPFUND_ABI exactly."
				},
				"fundCampaign(uint256)": {
					"details": "Contributes ETH to a campaign.      - Campaign must be ACTIVE and before deadline.      - msg.value must be >= minContribution.      - On success, status is re-evaluated (may flip to FUNDED).      - If newly FUNDED, reward tokens are minted immediately."
				},
				"isRegistered(address)": {
					"details": "Proxies to AccessControl.isRegistered()."
				},
				"tokenBalanceOf(address)": {
					"details": "Returns the RewardToken balance for a wallet."
				},
				"totalCampaigns()": {
					"details": "Proxies to CampaignManager.campaignCount().      Named totalCampaigns() to match frontend ABI."
				},
				"withdraw(uint256)": {
					"details": "Creator withdraws funds after campaign is FUNDED.      - Only callable once (fundsReleased flag in FundingVault).      - Reward tokens are minted first if not yet done."
				}
			},
			"title": "StartupFund",
			"version": 1
