		"devdoc": {
			"details": "Stores and manages all campaign data. Does NOT hold ETH.      Only the StartupFund contract (set as authorized) can write state.",
			"kind": "dev",
			"methods": {
				"checkStatus(uint256)": {
					"details": "Evaluates and updates the campaign status.      - Goal reached → FUNDED      - Deadline passed + goal not met → CANCELLED"
				},
				"createCampaign((string,string,string,string,string,string,uint256,uint256,uint256,string,uint256,uint256))": {
					"details": "Creates a new campaign. Called by StartupFund.createCampaign()."
				},
				"flagCampaign(uint256)": {
					"details": "Marks a campaign as FLAGGED by community vote. Called by StartupFund.flagCampaign()."
				},
				"setAuthorized(address)": {
					"details": "Called once after StartupFund is deployed."
				},
				"updateCampaign(uint256,string,string,string,string)": {
					"details": "Updates editable campaign fields. Only allowed before any contributor funds.      Called by StartupFund.updateCampaign()."
				},
				"updateRaisedAmount(uint256,uint256,bool)": {
					"details": "Updates the raised amount and backer count. Called by StartupFund.fundCampaign()."
				}
			},
			"title": "CampaignManager",
			"version": 1
