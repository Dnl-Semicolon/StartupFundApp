		"devdoc": {
			"details": "Orchestrates all user-facing actions.      - Does NOT hold ETH (all ETH goes to FundingVault).      - Delegates campaign data to CampaignManager.      - Delegates access control to AccessControl.      - Mints reward tokens via RewardToken. Function signatures must EXACTLY match STARTUPFUND_ABI in src/lib/contracts.ts.",
			"kind": "dev",
			"methods": {
				"claimRefund(uint256)": {
					"details": "Contributor claims a refund after campaign is CANCELLED or FLAGGED."
				},
				"createCampaign((string,string,string,string,string,string,uint256,uint256,uint256,string,uint256,uint256))": {
					"details": "Creates a new campaign. Only registered, unblocked users."
				},
				"flagCampaign(uint256)": {
					"details": "Community member flags a suspicious campaign."
				},
				"fundCampaign(uint256)": {
					"details": "Contributes ETH to a campaign."
				},
				"unflagCampaign(uint256)": {
					"details": "Removes the caller's flag from a campaign."
				},
				"updateCampaign(uint256,string,string,string,string)": {
					"details": "Updates editable campaign fields. Only creator, only before first contribution."
				},
				"withdraw(uint256)": {
					"details": "Creator withdraws funds after campaign is FUNDED."
				}
			},
			"title": "StartupFund",
			"version": 1
		},
